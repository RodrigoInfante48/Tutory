# Config del proyecto Firebase (Project settings → General → Tus apps → SDK setup and configuration)
# Estos valores NO son secretos (van embebidos en el bundle del cliente): la seguridad real
# la dan las Firestore/Storage Security Rules y la lista de "Authorized domains" en Firebase Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
