.productCtaSecondary:hover{background:var(--pillBg);}

/* ═══════════════════════════════════════════
   PRICING TABLE (two modes)
═══════════════════════════════════════════ */
.pricingWrap{
  border-radius:28px;
  border:1px solid var(--cardBorder);
  background:var(--card);
  box-shadow:var(--shadow),var(--insetTop);
  overflow:hidden;
}

.pricingTabs{
  display:flex;gap:6px;
  padding:16px 24px;
  border-bottom:1px solid var(--stroke);
  flex-wrap:wrap;
  align-items:center;
  justify-content:space-between;
}
.pricingTabsLeft{display:flex;gap:6px;flex-wrap:wrap;}

.pricingTab{
  padding:8px 18px;border-radius:999px;
  font-family:'DM Sans',sans-serif;
  font-size:13px;font-weight:700;
  color:var(--muted2);
  background:var(--tagBg);border:1px solid var(--tagBorder);
  cursor:pointer;transition:all .2s;user-select:none;
}
