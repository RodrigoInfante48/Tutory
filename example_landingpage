.packHeader{
  display:grid;
  grid-template-columns:1fr 150px 190px;
  padding:12px 28px;
  border-bottom:1px solid var(--stroke);
  background:var(--tableHeaderBg);
}
.packHeader span{
  font-size:11px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted2);
}
.packHeader span:not(:first-child){text-align:center;}

.packTable{display:none;}
.packTable.active{display:block;}

.packRow{
  display:grid;
  grid-template-columns:1fr 150px 190px;
  padding:18px 28px;
  border-bottom:1px solid var(--stroke);
  align-items:center;
  transition:background .2s;
}
.packRow:last-child{border-bottom:none;}
.packRow:hover{background:var(--tableRowHov);}

.packName{display:flex;align-items:center;gap:12px;}
.packEmoji{font-size:22px;}
