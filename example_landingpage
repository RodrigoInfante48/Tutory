   SECTION LABEL
═══════════════════════════════════════════ */
.sectionLabel{
  font-size:11px;font-weight:700;
  letter-spacing:.12em;text-transform:uppercase;
  color:var(--brand);
  margin-bottom:16px;
  display:flex;align-items:center;gap:10px;
}
.sectionLabel::after{
  content:'';flex:1;height:1px;
  background:var(--sectionLineBg);
}

.section{margin-top:36px;}

