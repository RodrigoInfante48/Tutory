  transition:background .2s,transform .15s;
  box-shadow:0 4px 20px rgba(var(--brandRgb),.25);
}
.heroCardCta:hover{background:var(--brand2);transform:translateY(-1px);}

/* ═══════════════════════════════════════════
   PRODUCTS GRID
═══════════════════════════════════════════ */
.productsGrid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.productCard{
  border-radius:24px;
  border:1px solid var(--cardBorder);
  background:var(--card);
  box-shadow:var(--shadowSm),var(--insetTop);
  padding:28px 24px 24px;
  position:relative;overflow:hidden;
  display:flex;flex-direction:column;
  transition:border-color .25s,transform .25s,box-shadow .25s;
  cursor:default;
}
.productCard:hover{
  border-color:var(--cardBorderHov);
  transform:translateY(-4px);
  box-shadow:0 22px 60px rgba(0,0,0,.32);
}

.productCard.featuredCard{
  border-color:var(--strokeG);
  background:linear-gradient(145deg,rgba(var(--brandRgb),.07),var(--card));
}

.productIcon{font-size:34px;margin-bottom:14px;display:block;animation:float 4s ease-in-out infinite;}
.productCard:nth-child(2) .productIcon{animation-delay:.6s;}
.productCard:nth-child(3) .productIcon{animation-delay:1.2s;}
.productCard:nth-child(4) .productIcon{animation-delay:1.8s;}
.productCard:nth-child(5) .productIcon{animation-delay:2.4s;}

.productTag{
  display:inline-flex;align-items:center;gap:6px;
  font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
