/* ═══════════════════════════════════════════
   RESET
═══════════════════════════════════════════ */
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}

body{
  font-family:'DM Sans',ui-sans-serif,sans-serif;
  color:var(--text);
  background:var(--bg0);
  background-image:
    radial-gradient(ellipse 900px 500px at 10% 0%,var(--heroGrad1),transparent 60%),
    radial-gradient(ellipse 700px 400px at 90% 15%,var(--heroGrad2),transparent 60%),
    radial-gradient(ellipse 600px 600px at 50% 100%,var(--heroGrad3),transparent 60%);
  min-height:100vh;
  transition:background .3s,color .3s;
}

h1,h2,h3,h4{font-family:'Sora',sans-serif;}

/* ═══════════════════════════════════════════
   ANIMATIONS
═══════════════════════════════════════════ */
@keyframes fadeUp{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:translateY(0);}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(.8);}}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-7px);}}

.reveal{opacity:0;transform:translateY(26px);transition:opacity .65s ease,transform .65s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* ═══════════════════════════════════════════
   NAV
═══════════════════════════════════════════ */
nav{
  position:sticky;top:0;z-index:200;
  background:var(--navBg);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--navBorder);
  padding:0 40px;
  height:62px;
  display:flex;align-items:center;justify-content:space-between;
  transition:background .3s,border-color .3s;
}

.navLogo{
  font-family:'Sora',sans-serif;
  font-size:17px;font-weight:900;
  color:var(--white);
  text-decoration:none;
  letter-spacing:-.02em;
  display:flex;align-items:center;gap:8px;
}
.navLogo .logoAccent{color:var(--brand);}

.navLinks{
  display:flex;align-items:center;gap:28px;list-style:none;
}
.navLinks a{
  font-size:14px;font-weight:600;
  color:var(--muted2);
  text-decoration:none;
  transition:color .2s;
}
.navLinks a:hover{color:var(--brand);}

.navRight{display:flex;align-items:center;gap:12px;}

/* Theme toggle */
.themeToggle{
  display:flex;align-items:center;gap:8px;
  padding:8px 14px;
  border-radius:999px;
  background:var(--toggleBg);
  border:1px solid var(--toggleBorder);
  cursor:pointer;
  transition:all .2s;
  font-family:'DM Sans',sans-serif;
  font-size:13px;font-weight:700;
  color:var(--muted2);
  user-select:none;
}
.themeToggle:hover{border-color:var(--strokeG);color:var(--brand);}
.themeToggle .tIcon{font-size:15px;transition:transform .3s;}
[data-theme="light"] .themeToggle .tIcon{transform:rotate(180deg);}

.navCta{
  padding:9px 20px;
  border-radius:999px;
  background:var(--brand);
  color:#030805;
  font-size:13px;font-weight:800;
  text-decoration:none;
  transition:background .2s,transform .15s,box-shadow .2s;
  box-shadow:0 4px 20px rgba(var(--brandRgb),.25);
  white-space:nowrap;
}
.navCta:hover{background:var(--brand2);transform:translateY(-1px);}

/* ═══════════════════════════════════════════
   MARQUEE
═══════════════════════════════════════════ */
.marqueeband{
  background:var(--bg2);
  border-bottom:1px solid var(--stroke);
  overflow:hidden;padding:10px 0;
  white-space:nowrap;
  transition:background .3s;
}
.marqueeinner{
  display:inline-flex;gap:0;
  animation:marquee 30s linear infinite;
}
.marqueeitem{
  font-size:12px;font-weight:700;
  letter-spacing:.07em;text-transform:uppercase;
  color:var(--marqueeText);
  padding:0 28px;
  display:inline-flex;align-items:center;gap:10px;
}
.marqueeitem .dot{
  width:5px;height:5px;border-radius:50%;
  background:var(--brand);
  box-shadow:0 0 6px var(--brand);
  flex-shrink:0;
}

