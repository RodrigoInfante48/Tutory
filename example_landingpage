  text-decoration:none;
  transition:border-color .2s,color .2s;
}
.ctaSecondary:hover{border-color:var(--brand);color:var(--brand);}

.heroStats{
  margin-top:38px;
  display:flex;gap:28px;
  padding-top:28px;
  border-top:1px solid var(--stroke);
  flex-wrap:wrap;
}
.heroStat{}
.heroStatNum{
  font-size:30px;font-weight:900;
  font-family:'Sora',sans-serif;
  color:var(--white);letter-spacing:-.02em;line-height:1;
}
.heroStatNum span{color:var(--brand);}
.heroStatLabel{font-size:12px;color:var(--muted2);margin-top:4px;font-weight:500;}

