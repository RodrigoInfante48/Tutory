.heroCard{
  background:var(--bg2);
  border-radius:24px;
  border:1px solid var(--cardBorder);
  padding:28px 24px 24px;
  position:relative;overflow:hidden;
  box-shadow:var(--shadowSm);
  z-index:1;
}
[data-theme="dark"] .heroCard{background:rgba(255,255,255,.04);}
[data-theme="light"] .heroCard{background:rgba(255,255,255,.8);}

.heroCardTag{
  display:inline-flex;align-items:center;gap:6px;
  font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--brand);
  background:var(--pillBg);border:1px solid var(--pillBorder);
  padding:5px 12px;border-radius:999px;
  margin-bottom:16px;
}
.heroCardTag .live{
  width:6px;height:6px;border-radius:50%;
  background:var(--brand);
  box-shadow:0 0 8px var(--brand);
  animation:pulse 2s infinite;
}

.heroCardTitle{
  font-size:18px;font-weight:900;
  color:var(--white);letter-spacing:-.02em;
  line-height:1.3;margin-bottom:16px;
}

.miniPackList{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:20px;}
.miniPackItem{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border-radius:12px;
  background:var(--tagBg);border:1px solid var(--tagBorder);
  transition:background .2s;
}
.miniPackItem:hover{background:var(--cardHov);}
.miniPackName{font-size:13px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:7px;}
.miniPackPrice{font-family:'Sora',sans-serif;font-size:14px;font-weight:900;color:var(--brand);}

.heroCardCta{
  display:block;width:100%;
